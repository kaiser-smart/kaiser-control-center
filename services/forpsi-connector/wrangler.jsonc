{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forpsi-company-mail-dev",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CONNECTOR_ENABLED": "false",
    "SOAI_DRAFTS_ENABLED": "false",
    "WORKFLOW_SYNC_ENABLED": "false",
    "MAIL_BRAIN_ENABLED": "false",
    "MAIL_BRAIN_V2_ENABLED": "false",
    "MAIL_BRAIN_V2_DAILY_CALL_LIMIT": "0",
    "MAIL_BRAIN_V2_ANALYSIS_MODE": "chatgpt",
    "MAIL_BRAIN_SCHEDULED_SYNC_ENABLED": "false",
    "MAIL_BRAIN_PILOT_READ_ONLY": "true",
    "SEND_ENABLED": "false",
    "FORPSI_ANALYSIS_MODEL": "gpt-5-mini"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forpsi-company-mail-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": false
  }
}
